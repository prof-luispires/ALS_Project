{
  "implementation": "Custom PyTorch DQN",
  "problem_interpretation": "contextual one-step channel selection",
  "gamma": 0.0,
  "reward": "canonical QoS feasibility + minimum transmit-energy-per-bit reference",
  "state_modes": {
    "environmental": [
      "distance_m",
      "rain_rate_mmph",
      "humidity_pct",
      "visibility_km",
      "Cn2"
    ],
    "full": [
      "distance_m",
      "rain_rate_mmph",
      "humidity_pct",
      "visibility_km",
      "Cn2",
      "SNR_RF_dB",
      "SNR_FSO_dB",
      "SNR_THz_dB",
      "Eb_RF_J_per_bit",
      "Eb_FSO_J_per_bit",
      "Eb_THz_J_per_bit"
    ]
  },
  "training_seeds": [
    11,
    22,
    33,
    44,
    55
  ],
  "hyperparameters": {
    "learning_rate": 0.001,
    "batch_size": 64,
